NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27018/dail-game
ACCESS_TOKEN_SECRET=replace_with_64_char_hex_generated_via_openssl
REFRESH_TOKEN_SECRET=replace_with_64_char_hex_generated_via_openssl
ACCESS_TOKEN_TTL_MS=900000
REFRESH_TOKEN_TTL_MS=604800000
FRONTEND_URL=http://localhost:3004
BACKEND_URL=http://localhost:5000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!1234
ADMIN_DISPLAY_NAME=Admin
ADMIN_USERNAME=admin

# ── Outgoing mail (email verification) ──────────────────────────────────────
# Defaults shown are Resend's SMTP relay (free tier: 3000/month, 100/day).
# Leave SMTP_HOST empty in local dev — verification links are logged instead.
# Any SMTP relay works: Brevo (smtp-relay.brevo.com), Zoho, your own Postfix.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
# The Resend API key (re_...) is used as the SMTP password.
SMTP_PASS=re_your_api_key_here
# Must be an address on the domain verified in Resend, or the send is rejected.
MAIL_FROM=Aydınlar Oynuyor <noreply@send.yourdomain.com>
# A real mailbox you actually read — replies to noreply@ go nowhere.
MAIL_REPLY_TO=you@example.com
EMAIL_VERIFICATION_TTL_MS=86400000
